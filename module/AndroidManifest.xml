<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.refresh165"
    android:versionCode="103"
    android:versionName="v1.0.3">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />

    <!--
      P2（audit）：声明 WRITE_SECURE_SETTINGS。作为普通应用此权限**不会**被授予
      （signature|privileged），声明本身不改变行为；磁贴也不再写 Secure/Global（B7）。
      若将来要让模块进程直接写 Secure，需要用户通过 adb 授权（pm grant 不可用于
      signature 权限）或系统签名/刷入 privapp —— 当前所有写入都发生在被 hook 的
      system_server / com.android.settings 进程内，因此无需该权限。
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <!-- PackageManager can expose the system's installed video handlers to Settings UI. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="video/*" />
        </intent>
    </queries>

    <application android:label="@string/app_name" android:description="@string/module_desc" android:hasCode="true">
        <meta-data android:name="xposedmodule"      android:value="true" />
        <meta-data android:name="xposeddescription" android:value="@string/module_desc" />
        <meta-data android:name="xposedminversion"  android:value="93" />
        <meta-data android:name="xposedscope"       android:resource="@array/xposedscope" />
        <service
            android:name=".Force165Tile"
            android:label="@string/tile_label"
            android:icon="@android:drawable/ic_menu_recent_history"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
